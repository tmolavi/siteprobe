# SiteProbe Environment Variables (Optional Integrations)

# Google Search Console (Path to Service Account JSON key)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google Analytics 4
GA4_PROPERTY_ID=123456789

# DataForSEO API Credentials
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# Optional AI Providers (for enhanced semantic analysis)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
